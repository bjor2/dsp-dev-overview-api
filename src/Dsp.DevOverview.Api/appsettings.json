{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Azure": "Warning"
    }
  },
  "Urls": "http://127.0.0.1:5090",
  "AllowedHosts": "*",
  "Overview": {
    "Root": "",
    "RegistrationSchema": "architecture/registration.schema.json",
    "Registrations": [ "architecture/registrations/customerproject.dev.json", "architecture/registrations/price.dev.json" ],
    "CommandPropertyProfile": null,
    "Health": {
      "SbProbeCacheSeconds": 5
    },
    "TraceIt": {
      "Url": "https://traceit-dev.sgdn.no"
    },
    "ServiceBus": {
      "Scope": "Local",
      "ConnectionString": "",
      "AdminConnectionString": "",
      "EmulatorAdminPort": 5300,
      "PeekCountCap": 250
    },
    "Console": {
      "BufferLines": 10000,
      "LogDir": "console",
      "PwshPath": "pwsh",
      "CustomerProjectRepo": "/workspace/dsp/dsp-customerproject-localrun",
      "DockerLogsCommand": "sudo -n docker logs -f --tail 200 {name}",
      "DockerContainerPrefix": "dsp-shared-",
      "DockerContainers": [ "dsp-shared-servicebus-1", "dsp-shared-servicebus-sql-1", "dsp-shared-sql-1", "dsp-shared-azurite-1" ],
      "StubTicker": null,
      "StubTickerIntervalMs": 1000,
      "HeartbeatSeconds": 15,
      "StopTimeoutSeconds": 10
    }
  }
}
