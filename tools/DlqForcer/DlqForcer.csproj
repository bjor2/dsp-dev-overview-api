<Project Sdk="Microsoft.NET.Sdk">
  <!-- Test helper: forces messages into a DLQ on the shared-stack emulator (PeekLock receive + DeadLetterMessageAsync)
       so slice 2 (DLQ list/retry/discard) can be exercised without editing the service or the stack. Emulator only. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Azure.Messaging.ServiceBus" Version="7.20.1" />
  </ItemGroup>
</Project>
